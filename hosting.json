{
  "name": "Solid Playground",
  "brand": {
    "logo": "brand/solid.svg",
    "logoDark": "brand/solid-dark.svg",
    "home": "https://www.solidjs.com/",
    "description": "Run SolidJS projects in your browser: edit, install and preview, with nothing to set up.",
    "card": "brand/card.png",
    "cardAlt": "Solid Playground: run SolidJS projects in your browser, beside the Solid logo"
  },
  "theme": {
    "family": "solid-light",
    "fonts": ["/fonts/geist/wght.css", "/fonts/geist-mono/wght.css"],
    "vars": {
      "base": {
        "--font-ui": "\"Geist Variable\", ui-sans-serif, system-ui, sans-serif",
        "--font-mono": "\"Geist Mono Variable\", ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
      }
    }
  },
  "localRunner": false,
  "languages": ["reactivescript"],
  "gallery": ["solid-start-devtools", "solid-vite-hmr", "solid-ssr-dashboard", "astro-solid-demo", "reactivescript", "reactivescript-selects"],
  "defaultProject": "solid-vite-hmr",
  "landing": false,
  "editorOrigins": ["https://solid.runbun.dev"]
}
